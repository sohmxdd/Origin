# Set default behavior to declare that all files with text signature should be normalized to LF
* text=auto eol=lf

# Force LF line endings explicitly for source files, configuration, and artifacts
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
